"""Pack Smart as a Python web app (Streamlit). Needs pack_smart.py in the same folder.

Run locally:  pip install -r requirements.txt
              streamlit run streamlit_app.py
"""
import random

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import streamlit as st

from pack_smart import (ALGOS, DEPOT, MAX_CAP, SAMPLE, Item, dist, pickup_trip,
                        run, validate_item)

st.set_page_config(page_title="Pack Smart", page_icon="🎒", layout="wide")

# ---------------------------------------------------------------- state
if "items" not in st.session_state:
    st.session_state.items = [Item(n, w, v) for n, w, v in SAMPLE]
    st.session_state.cap = 15
    st.session_state.msg = ""
items = st.session_state.items

# ---------------------------------------------------------------- sidebar: input + validation
with st.sidebar:
    st.header("Your items")
    st.session_state.cap = st.number_input("Bag capacity (weight)", 1, MAX_CAP, st.session_state.cap, 1)

    with st.form("add_item"):
        name = st.text_input("Item name", max_chars=20, placeholder="e.g. Laptop")
        w_text = st.text_input("Weight (1-999)", placeholder="e.g. 4")
        v_text = st.text_input("Value (1-999)", placeholder="e.g. 10")
        if st.form_submit_button("Add item", type="primary"):
            new, err = validate_item(items, name, w_text, v_text)
            if err:
                st.session_state.msg = err
            else:
                items.append(new)
                st.session_state.msg = ""
    if st.session_state.msg:
        st.error(st.session_state.msg)

    if items:
        gone = st.selectbox("Remove an item", [i.name for i in items], index=None, placeholder="Choose item")
        if gone and st.button("Remove"):
            items[:] = [i for i in items if i.name != gone]
            st.rerun()

    c1, c2, c3 = st.columns(3)
    if c1.button("Sample"):
        items[:] = [Item(n, w, v) for n, w, v in SAMPLE]
        st.session_state.cap = 15
        st.rerun()
    if c2.button("Random 8"):
        names = ["Tent", "Stove", "Lamp", "Rope", "Radio", "Map", "Pot", "Boots"]
        items[:] = [Item(n, random.randint(1, 9), random.randint(1, 20)) for n in names]
        st.session_state.cap = 20
        st.rerun()
    if c3.button("Clear"):
        items.clear()
        st.rerun()
    st.caption("Up to 15 items. Names must be unique.")

cap = st.session_state.cap

# ---------------------------------------------------------------- intro
st.title("🎒 Pack Smart")
a, b, c = st.columns(3)
a.info("**The problem**  \nChoose items that fit a weight limit and give the highest total value (0/1 knapsack).")
b.info("**Why it matters**  \nLoading vans, budgeting ads, picking projects, planning cargo.")
c.info("**What it computes**  \nChosen items, weight, value, pickup distance on a map and work done per algorithm.")

if not items:
    st.warning("Add at least one item in the sidebar to see results.")
    st.stop()

results = {k: run(k, items, cap) for k in ALGOS}
best = max(r["v"] for r in results.values())

tabs = st.tabs([r["name"] for r in results.values()] + ["🗺️ Map", "📊 Compare"])

# ---------------------------------------------------------------- one tab per algorithm
for tab, r in zip(tabs, results.values()):
    with tab:
        st.subheader(r["name"])
        m1, m2, m3 = st.columns(3)
        m1.metric("Time", r["time"])
        m2.metric("Space", r["space"])
        m3.metric("Optimal?", "Always" if r["exact"] else "Not always")
        st.markdown("**How it works**")
        for i, s in enumerate(r["steps"], 1):
            st.markdown(f"{i}. {s}")
        st.markdown("**Result for your items**")
        v1, v2 = st.columns(2)
        v1.metric("Total value", r["v"])
        v2.metric("Weight used", f"{r['w']} / {cap}")
        st.progress(min(r["w"] / cap, 1.0))
        st.write(", ".join(f"{items[i].name} (w{items[i].weight}, v{items[i].value})" for i in r["ids"]) or "Nothing fits")
        if r["v"] == best:
            st.success("Matches the best value found.")
        else:
            st.error(f"{best - r['v']} short of the best ({best}).")
        order, km = pickup_trip(items, r["ids"])
        if order:
            st.write(f"Pickup trip: **{km:.2f} km**  ({' → '.join(['Depot'] + [items[i].name for i in order] + ['Depot'])})")
        st.caption(f"Work done: {r['work']}. Run time: {r['ms']:.3f} ms.")

# ---------------------------------------------------------------- map
with tabs[-2]:
    pick = st.selectbox("Show packing from", [r["name"] for r in results.values()], index=4)
    res = next(r for r in results.values() if r["name"] == pick)
    order, km = pickup_trip(items, res["ids"])
    st.metric("Pickup trip", f"{km:.2f} km" if order else "no trip needed")

    fig, ax = plt.subplots(figsize=(8, 5.6))
    path = [DEPOT] + [(items[i].x, items[i].y) for i in order] + ([DEPOT] if order else [])
    for p, q in zip(path, path[1:]):
        ax.plot([p[0], q[0]], [p[1], q[1]], color="#c2410c", lw=2)
        ax.text((p[0] + q[0]) / 2, (p[1] + q[1]) / 2 - 0.12, f"{dist(p, q):.1f} km", fontsize=8, ha="center")
    for i, it in enumerate(items):
        ax.scatter(it.x, it.y, s=160, zorder=3, color="#c2410c" if i in res["ids"] else "#9a8f85")
        ax.text(it.x, it.y, str(i + 1), color="white", ha="center", va="center", fontsize=8, zorder=4)
        ax.text(it.x, it.y + 0.35, it.name, ha="center", fontsize=8)
    ax.scatter(*DEPOT, marker="s", s=200, color="black", zorder=3)
    ax.text(DEPOT[0], DEPOT[1], "D", color="white", ha="center", va="center", fontsize=8, zorder=4)
    ax.set_xlim(0, 10); ax.set_ylim(7, 0); ax.set_xlabel("km"); ax.set_ylabel("km"); ax.grid(alpha=.3)
    st.pyplot(fig)
    plt.close(fig)

    with st.expander("Move an item on the map"):
        who = st.selectbox("Item", range(len(items)), format_func=lambda i: items[i].name)
        items[who].x = st.slider("X (km)", 0.3, 9.7, float(items[who].x), 0.1, key=f"x{who}")
        items[who].y = st.slider("Y (km)", 0.3, 6.7, float(items[who].y), 0.1, key=f"y{who}")

# ---------------------------------------------------------------- compare
with tabs[-1]:
    rows = []
    for r in results.values():
        rows.append({"Approach": r["name"], "Time": r["time"], "Space": r["space"],
                     "Value": f"{r['v']}{' ★' if r['v'] == best else ''}", "Weight": f"{r['w']}/{cap}",
                     "Trip km": round(pickup_trip(items, r["ids"])[1], 2),
                     "Work done": r["work"], "Run ms": round(r["ms"], 3)})
    st.dataframe(rows, use_container_width=True, hide_index=True)
    st.caption("★ = best value. The four exact methods always agree; greedy may fall short.")
